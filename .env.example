# Postgres credentials — единый источник правды.
# docker-compose подхватывает отсюда и для контейнера БД, и для backend-а
# (прокидывает DB_* внутрь backend-контейнера через environment:).
#
# Подключение из IDE / psql на хосте:
#   host:     localhost
#   port:     ${DB_PORT_HOST}  (см. ниже)
#   database: ${DB_DATABASE}
#   username: ${DB_USERNAME}
#   password: ${DB_PASSWORD}

DB_DATABASE=feedback_board
DB_USERNAME=feedback_board
DB_PASSWORD=secret

# Порт, под которым Postgres торчит на хост. Поменяй, если 54321 занят.
DB_PORT_HOST=54321

# Для проверки с телефона в том же Wi-Fi: IP компьютера без http:// и порта.
# Например: VITE_HOST=192.168.1.100. После изменения пересоздай frontend и backend.
VITE_HOST=localhost

# Адрес приложения в письмах. Для теста с другого устройства укажи http://<IP>:5176.
FRONTEND_URL=http://localhost:5176
